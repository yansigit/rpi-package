  "normalization": {
    "c04Entries": "sessionId-><session-id>, sessionFile-><session-file>, scopeKey-><scope-key>, cwd-><cwd>, timestamps-><iso>, branchPathHash-><hash>, contextFingerprint-><fingerprint> (Pi carries its system prompt as a leading session message; the native port carries it in context.systemPrompt, so the opaque hash and message count are not comparable), storeIdentity.stateRoot-><store-root>, poolKey environment components (scope/cwd/16-hex store hash) normalized. agentId, cleanup action/phase and candidate/protected/deleted/failed agent ids are compared exactly.",
    "piJsonStream": "Each JSON line is re-serialized with timestamp, durationMs, executionTime set to 0; UUIDs to <uuid>; ISO-8601 timestamps to <iso>; session-file timestamps to <session-time>; Pi's random 8-hex entry id/parentId/anchorId to <entry>; cursor-replay-<ms>-<n>- to cursor-replay-<n>-<n>-; cursor-pi-bridge run IDs to <run>; pi-sessions/<32-hex store hash> to pi-sessions/<store>; the temporary root to <root>.",
    "fakeLog": "No normalization: the fake writes no clocks, PIDs or random IDs; only the temporary root is replaced by <root>."
  },
