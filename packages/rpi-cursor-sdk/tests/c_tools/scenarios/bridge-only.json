{
  "schema": "rpi-cursor-fake-sdk/1",
  "name": "bridge-only",
  "description": "One bridge-only turn: a single Pi tool executes through the adapter's MCP bridge and no native Cursor tool runs. Ledger C05/H08: zero Cursor native tools, one bridge execution, zero replay executions.",
  "run": {
    "model": "composer-2",
    "prompt": "Echo the bridge check text.",
    "extensions": [
      "fixtures/echo-extension.mjs"
    ]
  },
  "auth": {
    "apiKey": "fake"
  },
  "models": [
    {
      "id": "composer-2",
      "displayName": "Composer 2",
      "variants": [
        {
          "params": [],
          "displayName": "Composer 2",
          "isDefault": true
        }
      ]
    }
  ],
  "turns": [
    {
      "name": "bridge-echo",
      "expect": {
        "promptIncludes": "Echo the bridge check text.",
        "mcpServers": [
          "pi_tools"
        ]
      },
      "steps": [
        {
          "op": "text",
          "chunks": [
            "Calling the echo tool."
          ]
        },
        {
          "op": "mcpCall",
          "server": "pi_tools",
          "tool": "pi__fake_echo",
          "callId": "call-echo-1",
          "arguments": {
            "text": "bridge-check"
          }
        },
        {
          "op": "text",
          "chunks": [
            "The echo tool replied."
          ]
        },
        {
          "op": "usage",
          "usage": {
            "inputTokens": 40,
            "outputTokens": 21,
            "cacheReadTokens": 0,
            "cacheWriteTokens": 0
          }
        }
      ],
      "outcome": {
        "status": "finished",
        "result": "The echo tool replied."
      }
    }
  ],
  "cToolsExpect": {
    "nativeToolCalls": {},
    "bridgeToolExecutions": 1,
    "bridgeToolFailures": 0,
    "hostToolInvocations": {
      "fake_echo": 1
    },
    "replayToolExecutions": 0,
    "violations": 0
  }
}
